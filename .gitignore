# =====================================================================
#  Unreal Engine 5 - .gitignore
#  Only first-party work is versioned: Source, Config, .uproject
#  and the project's own folder inside Content/.
# =====================================================================

# --- Engine / build generated folders ------------------------------
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/*/
!Build/*/Resources/

# Project plugins: version source code, not binaries
Plugins/*/Binaries/
Plugins/*/Intermediate/

# --- IDEs -------------------------------------------------------------
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.code-workspace

# --- OS files ---------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# --- Third-party content (added from the editor / Fab) ----------------
# See README -> "How to open the project"
# StarterContent: only what the project uses is versioned
Content/StarterContent/*
!Content/StarterContent/Shapes/
!Content/StarterContent/Materials/
!Content/StarterContent/Textures/
Content/StarterContent/Textures/*
!Content/StarterContent/Textures/T_Concrete_Grime_D.uasset
!Content/StarterContent/Textures/T_Brick_Clay_Beveled_*.uasset
!Content/StarterContent/Textures/T_Wood_Floor_Walnut_*.uasset
!Content/StarterContent/Textures/T_Metal_Rust_*.uasset
Content/Characters/
Content/ThirdPerson/
Content/LevelPrototyping/
Content/Fab/
Content/Megascans/
Content/MSPresets/
*.slnx
Plugins/
Content/Input/
Content/__ExternalActors__/ThirdPerson/
Content/__ExternalObjects__/ThirdPerson/
